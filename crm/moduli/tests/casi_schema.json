    {"name": "an unknown operator", "schema": {"sections": [{"id": "s", "fields": [
      {"id": "a", "type": "text", "label": "A"},
      {"id": "b", "type": "text", "label": "B", "show_if": [[{"field": "a", "operator": "resembles", "value": "1"}]]}]}]}, "expected": ["invalid_operator"]},
    {"name": "a text to read cannot be asked about", "schema": {"sections": [{"id": "s", "fields": [
      {"id": "p", "type": "paragraph", "text": "Read me"},
      {"id": "a", "type": "text", "label": "A", "show_if": [[{"field": "p", "operator": "is_set"}]]}]}]}, "expected": ["invalid_condition"]},
    {"name": "a score counting words", "schema": {"sections": [{"id": "s", "fields": [
      {"id": "a", "type": "text", "label": "A"},
      {"id": "t", "type": "score", "label": "T", "sources": ["a"]}]}]}, "expected": ["invalid_source"]},
    {"name": "a band upside down", "schema": {"sections": [{"id": "s", "fields": [
      {"id": "a", "type": "scale", "label": "A"},
      {"id": "t", "type": "score", "label": "T", "sources": ["a"], "bands": [{"from": 5, "to": 1, "label": "X"}]}]}]}, "expected": ["invalid_band"]},
    {"name": "a scale going nowhere", "schema": {"sections": [{"id": "s", "fields": [
      {"id": "a", "type": "scale", "label": "A", "min": 3, "max": 3}]}]}, "expected": ["invalid_scale"]},
    {"name": "a number whose least is above its most", "schema": {"sections": [{"id": "s", "fields": [
      {"id": "a", "type": "number", "label": "A", "min": 10, "max": 1}]}]}, "expected": ["min_above_max"]},
    {"name": "too many decimals", "schema": {"sections": [{"id": "s", "fields": [
      {"id": "a", "type": "number", "label": "A", "decimals": 9}]}]}, "expected": ["invalid_decimals"]},
    {"name": "a signature by nobody", "schema": {"sections": [{"id": "s", "fields": [
      {"id": "a", "type": "signature", "label": "A", "signer": "the cat"}]}]}, "expected": ["invalid_signer"]},
    {"name": "a signature of an unknown level", "schema": {"sections": [{"id": "s", "fields": [
      {"id": "a", "type": "signature", "label": "A", "level": "notarised"}]}]}, "expected": ["invalid_signature_level"]},
    {"name": "a consent to nothing", "schema": {"sections": [{"id": "s", "fields": [
      {"id": "a", "type": "consent", "label": "A"}]}]}, "expected": ["missing_consent_type"]},
    {"name": "a text to read with no words", "schema": {"sections": [{"id": "s", "fields": [
      {"id": "p", "type": "paragraph", "text": "  "}]}]}, "expected": ["missing_text"]},
