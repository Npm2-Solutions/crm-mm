      {"id": "b", "type": "text", "label": "B"}]}]}, "expected": ["later_reference"]},
    {"name": "stopping on a later answer is fine", "schema": {"sections": [{"id": "s", "fields": [
      {"id": "a", "type": "text", "label": "A", "stop_if": [[{"field": "b", "operator": "is_set"}]]},
      {"id": "b", "type": "text", "label": "B"}]}]}, "expected": []},
    {"name": "a section showing on an answer inside it", "schema": {"sections": [{"id": "s", "show_if": [[{"field": "a", "operator": "is_set"}]], "fields": [
