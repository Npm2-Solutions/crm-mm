 "component_data_script": "# Products published on the website, from CRM Product.\n# Props: titolo, limite. Text is escaped here — the renderer does not autoescape.\nlimite = frappe.utils.cint(props.limite)\nif limite < 1 or limite > 48:\n\tlimite = 6\n\nrows = frappe.get_all(\n\t\"CRM Product\",\n\tfilters={\"disabled\": 0, \"publish_on_website\": 1},\n\tfields=[\"name\", \"product_name\", \"short_description\", \"website_slug\", \"image\",\n\t        \"standard_rate\", \"cta_label\"],\n\torder_by=\"website_order asc, product_name asc\",\n\tlimit_page_length=limite,\n)\n\nprodotti = []\nfor row in rows:\n\tprezzo = \"\"\n\tif row.standard_rate:\n\t\tprezzo = frappe.utils.fmt_money(row.standard_rate)\n\tprodotti.append({\n\t\t\"nome\": frappe.utils.escape_html(row.product_name or row.name),\n\t\t\"descrizione\": frappe.utils.escape_html(row.short_description or \"\"),\n\t\t\"immagine\": row.image or BLANK_PIXEL,\n\t\t\"link\": \"/prodotti/\" + (row.website_slug or \"\"),\n\t\t\"cta\": frappe.utils.escape_html(row.cta_label or \"Dettagli\"),\n\t\t\"prezzo\": prezzo,\n\t})\n\ncomponent[\"prodotti\"] = prodotti\ncomponent[\"vuoto\"] = 0 if prodotti else 1\n",
 "block": "{\"blockId\":\"crm-prodotti-root\",\"element\":\"div\",\"children\":[{\"blockId\":\"crm-prodotti-titolo\",\"element\":\"h2\",\"children\":[],\"baseStyles\":{\"fontSize\":\"1.75rem\",\"fontWeight\":\"600\",\"lineHeight\":\"1.2\",\"color\":\"#171717\"},\"mobileStyles\":{},\"tabletStyles\":{},\"rawStyles\":{},\"attributes\":{},\"customAttributes\":{},\"classes\":[],\"dataKey\":null,\"innerHTML\":\"I nostri prodotti\",\"dynamicValues\":[{\"key\":\"titolo\",\"type\":\"key\",\"property\":\"innerHTML\",\"comesFrom\":\"props\"}]},{\"blockId\":\"crm-prodotti-grid\",\"element\":\"div\",\"children\":[{\"blockId\":\"crm-prodotti-repeater\",\"element\":\"div\",\"children\":[{\"blockId\":\"crm-prodotti-card\",\"element\":\"div\",\"children\":[{\"blockId\":\"crm-prodotti-img\",\"element\":\"img\",\"children\":[],\"baseStyles\":{\"width\":\"100%\",\"height\":\"180px\",\"objectFit\":\"cover\",\"borderRadius\":\"8px\"},\"mobileStyles\":{},\"tabletStyles\":{},\"rawStyles\":{},\"attributes\":{\"src\":\"\",\"alt\":\"\",\"loading\":\"lazy\"},\"customAttributes\":{},\"classes\":[],\"dataKey\":null,\"dynamicValues\":[{\"key\":\"immagine\",\"type\":\"key\",\"property\":\"src\",\"comesFrom\":\"componentData\"}]},{\"blockId\":\"crm-prodotti-nome\",\"element\":\"h3\",\"children\":[],\"baseStyles\":{\"fontSize\":\"1.05rem\",\"fontWeight\":\"600\",\"color\":\"#171717\"},\"mobileStyles\":{},\"tabletStyles\":{},\"rawStyles\":{},\"attributes\":{},\"customAttributes\":{},\"classes\":[],\"dataKey\":null,\"innerHTML\":\"Nome prodotto\",\"dynamicValues\":[{\"key\":\"nome\",\"type\":\"key\",\"property\":\"innerHTML\",\"comesFrom\":\"componentData\"}]},{\"blockId\":\"crm-prodotti-desc\",\"element\":\"p\",\"children\":[],\"baseStyles\":{\"fontSize\":\"0.9rem\",\"lineHeight\":\"1.55\",\"color\":\"#737373\",\"margin\":\"0\"},\"mobileStyles\":{},\"tabletStyles\":{},\"rawStyles\":{},\"attributes\":{},\"customAttributes\":{},\"classes\":[],\"dataKey\":null,\"innerHTML\":\"Descrizione breve\",\"dynam