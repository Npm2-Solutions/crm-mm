 "component_data_script": "# Servizi pubblicati sul sito, letti da CRM Service.\n# Props: titolo (str), categoria (str, vuoto = tutte le categorie), limite (str/int)\n#\n# ATTENZIONE — l'ambiente Jinja di Frappe NON fa autoescape (FrappeSandboxedEnvironment\n# non passa autoescape, e il default di Jinja e' False), e Builder non emette \"|safe\".\n# Quindi ogni valore che finisce in un binding esce come HTML: il testo che arriva dai\n# campi del CRM va escapato qui, altrimenti un \"<\" in un nome servizio finisce in pagina.\nfilters = {\"enabled\": 1}\nif props.categoria:\n\tfilters[\"category\"] = props.categoria\n\nlimite = frappe.utils.cint(props.limite)\nif limite < 1 or limite > 48:\n\tlimite = 6\n\nrows = frappe.get_all(\n\t\"CRM Service\",\n\tfilters=filters,\n\tfields=[\"name\", \"service_name\", \"description\", \"category\", \"duration\", \"default_price\", \"currency\"],\n\torder_by=\"service_name asc\",\n\tlimit_page_length=limite,\n)\n\nservizi = []\nfor row in rows:\n\tprezzo = \"\"\n\tif row.default_price:\n\t\tprezzo = frappe.utils.fmt_money(row.default_price, currency=row.currency or \"EUR\")\n\tdurata = \"\"\n\tif row.duration:\n\t\tdurata = frappe.utils.cstr(row.duration) + \" min\"\n\tservizi.append({\n\t\t\"nome\": frappe.utils.escape_html(row.service_name or row.name),\n\t\t\"descrizione\": frappe.utils.escape_html(row.description or \"\"),\n\t\t\"categoria\": frappe.utils.escape_html(row.category or \"\"),\n\t\t\"durata\": durata,\n\t\t\"prezzo\": prezzo,\n\t})\n\ncomponent[\"servizi\"] = servizi\ncomponent[\"vuoto\"] = 0 if servizi else 1\n",
 "block": "{\"blockId\":\"crm-servizi-root\",\"element\":\"div\",\"children\":[{\"blockId\":\"crm-servizi-titolo\",\"element\":\"h2\",\"children\":[],\"baseStyles\":{\"fontSize\":\"1.75rem\",\"fontWeight\":\"600\",\"lineHeight\":\"1.2\",\"color\":\"#171717\"},\"mobileStyles\":{},\"tabletStyles\":{},\"rawStyles\":{},\"attributes\":{},\"customAttributes\":{},\"classes\":[],\"dataKey\":null,\"innerHTML\":\"I nostri servizi\",\"dynamicValues\":[{\"key\":\"titolo\",\"type\":\"key\",\"property\":\"innerHTML\",\"comesFrom\":\"props\"}]},{\"blockId\":\"crm-servizi-grid\",\"element\":\"div\",\"children\":[{\"blockId\":\"crm-servizi-repeater\",\"element\":\"div\",\"children\":[{\"blockId\":\"crm-servizi-card\",\"element\":\"div\",\"children\":[{\"blockId\":\"crm-servizi-nome\",\"element\":\"h3\",\"children\":[],\"baseStyles\":{\"fontSize\":\"1.05rem\",\"fontWeight\":\"600\",\"lineHeight\":\"1.3\",\"color\":\"#171717\"},\"mobileStyles\":{},\"tabletStyles\":{},\"rawStyles\":{},\"attributes\":{},\"customAttributes\":{},\"classes\":[],\"dataKey\":null,\"innerHTML\":\"Nome servizio\",\"dynamicValues\":[{\"key\":\"nome\",\"type\":\"key\",\"property\":\"innerHTML\",\"comesFrom\":\"componentData\"}]},{\"blockId\":\"crm-servizi-desc\",\"element\":\"p\",\"children\":[],\"baseStyles\":{\"fontSize\":\"0.9rem\",\"lineHeight\":\"1.55\",\"color\":\"#737373\",\"margin\":\"0\"},\"mobileStyles\":{},\"tabletStyles\":{},\"rawStyles\":{},\"attributes\":{},\"customAttributes\":{},\"classes\":[],\"dataKey\":null,\"innerHTML\":\"Descrizione del servizio\",\"dynamicValues\":[{\"key\":\"descrizione\",\"type\":\"key\",\"property\":\"innerHTML\",\"comesFrom\":\"componentData\"}]},{\"blockId\":\"crm-servizi-meta\",\"element\":\"div\",\"children\":[{\"blockId\":\"crm-servizi-durata\",\"element\":\"span\",\"children\":[],\"baseStyles\":{},\"mobileStyles\":{},\"tabletStyles\":{},\"rawStyles\":{},\"attributes\":{},\"customAttributes\":{},\"classes\":[],\"dataKey\":null,\"innerHTML\":\"\",\"dynamicValues\":[{\"key\":\"durata\",\"type\":\"key\",\"property\":\"innerHTML\",\"comesFrom\":\"componentData\"}]},{\"blockId\":\"crm-servizi-prezzo\",\"element\":\"span\",\"children\":[],\"baseStyles\":{\"fontWeight\":\"600\",\"color\":\"#171717\"},\"mobileStyles\":{},\"tabletStyles\":{},\"rawStyles\":{},\"attributes\":{},\"customAttributes\":{},\"classes\":[],\"dataKey\":null,\"innerHTML\":\"\",\"dynamicValues\":[{\"key\":\"prezzo\",\"type\":\"key\",\"property\":\"innerHTML\",\"comesFrom\":\"componentData\"}]}],\"baseStyles\":{\"display\":\"flex\",\"gap\":\"12px\",\"marginTop\":\"auto\",\"paddingTop\":\"8px\",\"fontSize\":\"0.85rem\",\"color\":\"#525252\"},\"mobileStyles\":{},\"tabletStyles\":{},\"rawStyles\":{},\"attributes\":{},\"customAttributes\":{},\"classes\":[],\"dataKey\":null}],\"baseStyles\":{\"display\":\"flex\",\"flexDirection\":\"column\",\"gap\":\"8px\",\"padding\":\"20px\",\"border\":\"1px solid #e5e5e5\",\"borderRadius\":\"10px\",\"background\":\"#ffffff\",\"height\":\"100%\"},\"mobileStyles\":{},\"tabletStyles\":{},\"rawStyles\":{},\"attributes\":{},\"customAttributes\":{},\"classes\":[],\"dataKey\":null}],\"baseStyles\":{},\"mobileStyles\":{},\"tabletStyles\":{},\"rawStyles\":{},\"attributes\":{},\"customAttributes\":{},\"classes\":[],\"dataKey\":{\"key\":\"servizi\",\"property\":\"dataKey\",\"type\":\"key\",\"comesFrom\":\"componentData\"},\"isRepeaterBlock\":true}],\"baseStyles\":{\"display\":\"grid\",\"gridTemplateColumns\":\"repeat(auto-fill, minmax(260px, 1fr))\",\"gap\":\"16px\",\"width\":\"100%\"},\"mobileStyles\":{\"gridTemplateColumns\":\"1fr\"},\"tabletStyles\":{},\"rawStyles\":{},\"attributes\":{},\"customAttributes\":{},\"classes\":[],\"dataKey\":null}],\"baseStyles\":{\"display\":\"flex\",\"flexDirection\":\"column\",\"gap\":\"24px\",\"width\":\"100%\",\"padding\":\"48px 24px\"},\"mobileStyles\":{},\"tabletStyles\":{},\"rawStyles\":{},\"attributes\":{},\"customAttributes\":{},\"classes\":[],\"dataKey\":null,\"props\":{\"titolo\":{\"isStandard\":true,\"value\":null,\"propOptions\":{\"type\":\"string\",\"options\":{\"defaultValue\":\"I nostri servizi\"}}},\"categoria\":{\"isStandard\":true,\"value\":null,\"propOptions\":{\"type\":\"string\",\"options\":{\"defaultValue\":\"\"}}},\"limite\":{\"isStandard\":true,\"value\":null,\"propOptions\":{\"type\":\"string\",\"options\":{\"defaultValue\":\"6\"}}}}}",
