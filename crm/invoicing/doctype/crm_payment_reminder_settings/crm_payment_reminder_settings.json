   "label": "How to pay"
  },
  {
   "fieldname": "how_to_pay",
   "fieldtype": "Small Text",
   "label": "How to pay",
   "description": "Shown to the person in their area beside what is left to pay, and in the reminders: an IBAN, «at the desk», a payment link. Empty, nothing is said."
  },
  {
   "fieldname": "reminders_section",
   "fieldtype": "Section Break",
   "label": "Payment reminders"
  },
  {
   "default": "0",
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Remind the clients of invoices still to pay",
   "description": "Every morning, a polite reminder of an invoice issued to a person and not collected yet. Never a credit note nor a test invoice. Off to start with."
  },
  {
   "default": "7",
   "fieldname": "first_after_days",
   "fieldtype": "Int",
   "label": "First reminder, days after the due date",
   "depends_on": "enabled",
   "description": "The due date is the last one of the invoice's payment schedule, else the day it was issued."
  },
  {
   "default": "14",
   "fieldname": "every_days",
   "fieldtype": "Int",
   "label": "Days between reminders",
   "depends_on": "enabled"
  },
  {
   "fieldname": "column_reminders",
   "fieldtype": "Column Break"
  },
