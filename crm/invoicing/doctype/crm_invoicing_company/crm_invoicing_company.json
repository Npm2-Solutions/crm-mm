   "fieldtype": "Data",
   "label": "Facility code (SSA)",
   "length": 6
  },
  {
   "description": "The centre's own, from the Sistema TS portal: with them the expenses are reported in the centre's name.",
   "fieldname": "ts_credentials_section",
   "fieldtype": "Section Break",
   "label": "Sistema TS credentials"
  },
  {
   "depends_on": "eval:doc.ts_mode!='export'",
   "description": "The centre's own Sistema TS user. Entered by whoever runs the centre, from their own settings - not collected and held on their behalf. A credential you do not hold is an incident you cannot have.",
   "fieldname": "ts_username",
   "fieldtype": "Data",
   "label": "Sistema TS user"
  },
  {
   "fieldname": "column_ts_credentials",
   "fieldtype": "Column Break"
  },
