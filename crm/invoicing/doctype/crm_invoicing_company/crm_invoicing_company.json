   "permlevel": 1
  },
  {
   "fieldname": "preservation_section",
   "fieldtype": "Section Break",
   "label": "Preservation",
   "permlevel": 1
  },
  {
   "default": "analogico_con_copia",
   "description": "The invoices that never go through the SdI: a healthcare service to a private person, a document given only as a PDF (Circolare 18/E 2014).",
   "fieldname": "document_mode",
   "fieldtype": "Select",
   "label": "Documents outside the SdI",
   "options": "analogico_con_copia\nelettronica_extra_sdi",
   "permlevel": 1
  },
  {
   "depends_on": "eval:doc.document_mode=='elettronica_extra_sdi'",
   "description": "Healthcare invoices to a private person never go through the SdI, so the Agenzia's free service cannot keep them: born electronic, they need a preservation service of their own. Or go back to the paper original.",
   "fieldname": "conservation_local",
   "fieldtype": "Select",
   "label": "Preservation, documents outside the SdI",
   "options": "\nprovider\naltro",
   "permlevel": 1
  },
  {
   "fieldname": "column_preservation",
   "fieldtype": "Column Break",
   "permlevel": 1
  },
  {
   "description": "Ten years is mandatory and transmitting does not provide it. The Agenzia's service is free and keeps them fifteen years, but it needs an explicit adhesion in Fatture e Corrispettivi and only covers invoices from that day on.",
   "fieldname": "conservation_service",
   "fieldtype": "Select",
   "label": "Preservation, SdI documents",
   "options": "\nagenzia_entrate\nprovider\naltro",
   "permlevel": 1
  },
  {
   "depends_on": "eval:doc.conservation_service||doc.conservation_local",
   "description": "Who preserves each branch, and since when. A note for whoever asks in eight years - name both if the two branches went to different preservers.",
   "fieldname": "conservation_reference",
   "fieldtype": "Data",
   "label": "Preservation reference",
   "permlevel": 1
  },
  {
   "fieldname": "tab_sdi",
   "fieldtype": "Tab Break",
   "label": "Transmission",
   "permlevel": 1
  },
  {
   "fieldname": "sdi_section",
   "fieldtype": "Section Break",
   "label": "Sistema di Interscambio",
   "permlevel": 1
  },
  {
   "default": "provider",
   "description": "Itala, the accredited intermediary, is the one offered to every centre: the centre sets nothing up. Downloading the file and the centre's own PEC stay possible, for the agency to choose.",
   "fieldname": "sdi_mode",
   "fieldtype": "Select",
   "label": "How invoices reach the SdI",
   "options": "export\npec\nprovider",
   "permlevel": 1
  },
  {
   "default": "uscita",
   "depends_on": "eval:doc.sdi_mode=='provider'",
   "description": "With incoming invoices too, the ones your suppliers send are filed here: a register of what arrived, not accounts (no matching, no approval). Turn it on only where somebody will read them.",
   "fieldname": "sdi_flow",
   "fieldtype": "Select",
   "label": "Which direction",
   "options": "uscita\nentrambi",
   "permlevel": 1
  },
  {
   "default": "sandbox",
   "description": "A company starts in test: its invoices are numbered PROVA, the electronic ones go to Itala's test environment and nothing reaches the SdI, the Sistema TS or the client. It goes live from Settings > Invoicing > Test and go live.",
   "fieldname": "provider_environment",
   "fieldtype": "Select",
   "label": "Test or live",
   "options": "sandbox\nproduction",
   "permlevel": 1
  },
  {
   "fieldname": "live_since",
   "fieldtype": "Datetime",
   "label": "Live since",
   "permlevel": 1,
   "read_only": 1
  },
  {
   "fieldname": "column_sdi",
   "fieldtype": "Column Break",
   "permlevel": 1
  },
  {
   "depends_on": "eval:doc.sdi_mode=='provider'",
   "description": "The company's identifier under the agency's account, given when it is registered.",
   "fieldname": "itala_id_test",
   "fieldtype": "Data",
   "label": "Itala, test environment",
   "permlevel": 1,
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.sdi_mode=='provider'",
   "fieldname": "itala_id",
   "fieldtype": "Data",
   "label": "Itala, production",
   "permlevel": 1,
   "read_only": 1
  },
  {
   "description": "Only for a company with an Itala account of its own. Empty, the agency's account is used and the company is registered under it by itself.",
   "fieldname": "sdi_username",
   "fieldtype": "Data",
   "label": "Own Itala account: client ID",
   "permlevel": 1
  },
  {
   "fieldname": "sdi_password",
   "fieldtype": "Password",
   "label": "Client secret",
   "permlevel": 1
  },
  {
   "depends_on": "eval:doc.sdi_mode=='provider'",
   "description": "Only for a company with an account of its own: the token Itala sends back when it pushes updates here, as Authorization: Bearer. Under the agency's account the updates are fetched every few minutes.",
   "fieldname": "sdi_webhook_secret",
   "fieldtype": "Password",
   "label": "Webhook secret",
   "permlevel": 1
  },
  {
   "default": "sdi01@pec.fatturapa.it",
   "depends_on": "eval:doc.sdi_mode=='pec'",
   "description": "Only the first invoice goes to sdi01@. The delivery receipt names the address to use from then on, and this is updated when it does.",
   "fieldname": "sdi_pec_address",
   "fieldtype": "Data",
   "label": "SdI mailbox",
   "permlevel": 1
  },
  {
   "description": "The SdI refuses a file name it has already seen, and it does not forget.",
   "fieldname": "sdi_last_progressive",
   "fieldtype": "Int",
   "label": "Last transmission progressive",
   "permlevel": 1,
   "read_only": 1
  }
 ],
