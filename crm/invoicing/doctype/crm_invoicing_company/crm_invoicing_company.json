   "fieldname": "sender_category",
   "fieldtype": "Select",
   "label": "Who issues, for the Sistema TS",
   "options": "non_sanitario\nmedico_odontoiatra\nprofessionista_sanitario\nstruttura_autorizzata\nstruttura_accreditata\nveterinario\nfarmacia\nparafarmacia\nottico"
