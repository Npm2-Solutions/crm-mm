   "fieldname": "ts_transmission_section",
   "fieldtype": "Section Break",
   "label": "Sistema TS transmission",
   "permlevel": 1
  },
  {
   "default": "credenziali_studio",
   "description": "With the centre's own credentials no document costs anything to report. The credentials belong to the centre and are entered by the centre.",
   "fieldname": "ts_mode",
   "fieldtype": "Select",
   "label": "How expenses reach the Sistema TS",
   "options": "credenziali_studio\nintermediario\nexport",
   "permlevel": 1
  },
  {
   "default": "sconosciuta",
   "description": "Not asked for: the Sistema TS's answer to the first report says it.",
   "fieldname": "ts_delegation_status",
   "fieldtype": "Select",
   "label": "Entratel mandate",
   "options": "sconosciuta\nassente\npresente\nnon_sondabile",
   "permlevel": 1,
   "read_only": 1
  },
  {
   "fieldname": "column_ts_transmission",
   "fieldtype": "Column Break",
   "permlevel": 1
  },
  {
   "description": "From the official kit. Empty here, the one in the invoicing settings is used for every company. It expires and is reissued: with an expired one every report is refused, silently.",
   "fieldname": "ts_certificate",
   "fieldtype": "Attach",
   "label": "Sistema TS certificate (SanitelCF.cer)",
   "permlevel": 1
  },
  {
   "depends_on": "eval:doc.ts_mode=='intermediario'",
   "description": "The intermediary's tax code and Entratel office, for example 07874631000-000.",
   "fieldname": "ts_intermediary_reference",
   "fieldtype": "Data",
   "label": "Entratel reference",
   "permlevel": 1
  },
  {
   "fieldname": "tab_documents",
