#: crm/documenti/consegna.py
msgid "<p>A document from {0} is ready for you.</p><p><a href=\"{1}\">Open it here</a>, until {2}.</p><p>You will need the code the centre gave you: it is not in this email.</p>"
msgstr "<p>È pronto un documento che ti manda {0}.</p><p><a href=\"{1}\">Aprilo qui</a>, fino al {2}.</p><p>Ti servirà il codice che ti ha dato il centro: in questa email non c'è.</p>"

#: frontend/src/components/Settings/EmailTemplate/EditEmailTemplate.vue:95
#: frontend/src/components/Settings/EmailTemplate/NewEmailTemplate.vue:95
msgid "<p>Dear {{ lead_name }},</p>\\n\\n<p>This is a reminder for the payment of {{ grand_total }}.</p>\\n\\n<p>Thanks,</p>\\n<p>The team</p>"
msgstr "<p>Gentile {{ lead_name }},</p>\n\n<p>ti ricordiamo il pagamento di {{ grand_total }}.</p>\n\n<p>Grazie,</p>\n<p>Lo staff</p>"

#: crm/area/messaggi.py
msgid "<p>There is news for you in your area.</p><p><a href=\"{0}\">Open it here</a>.</p>"
msgstr "<p>C'è una novità per te nella tua area.</p><p><a href=\"{0}\">Aprila da qui</a>.</p>"

#: crm/area/accesso.py
msgid "<p>{0} opened your area: your appointments, the documents they give you, your invoices.</p><p><a href=\"{1}\">Enter here</a> with this address: we send you a code each time.</p>"
msgstr "<p>La tua area presso {0} è aperta: i tuoi appuntamenti, i documenti che il centro ti consegna, le tue fatture.</p><p><a href=\"{1}\">Entra da qui</a> con questo indirizzo email: ogni volta ti mandiamo un codice.</p>"

