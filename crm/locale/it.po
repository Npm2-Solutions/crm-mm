#: frontend/src/components/Settings/Telephony/MoveNumberDialog.vue
msgid "A number the centre already has"
msgstr "Un numero che il centro ha già"

#: frontend/src/components/Settings/Telephony/MoveNumberDialog.vue
msgid "In the centre’s Twilio account"
msgstr "Nell'account Twilio del centro"

#: frontend/src/components/Settings/Telephony/MoveNumberDialog.vue
msgid "It moves into {brand}’s space, with its documents."
msgstr "Si sposta nello spazio di {brand}, con i suoi documenti."

#: frontend/src/components/Settings/Telephony/MoveNumberDialog.vue
