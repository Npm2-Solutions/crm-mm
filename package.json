{
	"private": true,
	"type": "module",
	"name": "crm",
	"description": "DottorCloud, il gestionale per i centri medici",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Npm2-Solutions/crm-mm.git"
	},
	"author": "NPM2 Solutions Srl",
	"license": "GPL-3.0",
	"bugs": {
		"url": "https://github.com/Npm2-Solutions/crm-mm/issues"
	},
	"scripts": {
		"postinstall": "cd frontend && yarn install --check-files",
		"dev": "cd frontend && yarn dev",
		"build": "cd frontend && yarn build",
		"upgrade-frappeui": "cd frontend && yarn add frappe-ui@latest && cd ..",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:debug": "playwright test --debug",
		"simulazione": "playwright test -c e2e/simulazione/playwright.config.ts"
	},
	"devDependencies": {
		"@playwright/test": "^1.49.0",
		"@types/node": "^22.0.0"
	}
}
